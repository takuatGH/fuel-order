# FuelFlow Environment Configuration
# Copy to .env and fill in your values

# --- App ---
APP_NAME=FuelFlow
DEBUG=true

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fuelflow

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- WhatsApp Cloud API ---
# Get these from Meta Developer Console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_WEBHOOK_SECRET=

# --- Security ---
SECRET_KEY=generate-with-openssl-rand-hex-32

# --- Admin ---
# Protects /admin/* endpoints. Leave blank to disable auth (dev only).
ADMIN_API_KEY=
# WhatsApp number to receive order completion digests (international format, no +)
ADMIN_WHATSAPP_NUMBER=27833050044

# --- Rate Limiting ---
# Max messages per phone number per minute on the webhook endpoint
WEBHOOK_RATE_LIMIT_PER_MINUTE=10

# --- Pricing ---
# Fallback price per liter (ZAR) used if depot has no price set
DEFAULT_PRICE_PER_LITER=15.0

# --- Feature Flags ---
ENABLE_SIGNATURE_VERIFICATION=false
ENABLE_IOT_ENDPOINTS=false